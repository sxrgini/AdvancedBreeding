    "main": ["com.iiampanda.icbreed.IcBreed"],
    "client": ["com.iiampanda.icbreed.client.IcBreedClient"]
  },
  "mixins": ["advbreeding.mixins.json", {"config": "advbreeding.client.mixins.json", "environment": "client"}],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": ">=26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
